# Canonical account-runtime invocation request v1. The accepted language is
# the intersection of this grammar and account-runtime.schema.json. It has no
# production for raw shell, argv, inline prompt/output, credentials, transport
# coordinates or authority minting.
root ::= request
request ::= "{\"$schema\":\"https://wellmanifest.dev/schemas/account-runtime/v1\",\"schema\":\"wellmanifest.account-runtime-request/v1\",\"requestId\":" identifier ",\"operation\":" operation ",\"endpointRef\":" mcp-ref ",\"target\":{\"runtimeRef\":" runtime-ref ",\"identityRef\":" identity-ref ",\"providerRef\":" provider-ref ",\"toolRef\":" tool-ref ",\"projectRef\":" project-ref "},\"task\":{\"kind\":\"llm-query\",\"promptRef\":" artifact-ref ",\"inputRefs\":" artifact-list ",\"outputContractRef\":" schema-ref "},\"limits\":{\"timeoutSeconds\":" positive-int ",\"maxArtifacts\":" nonnegative-int ",\"maxOutputBytes\":" positive-int "},\"authority\":{\"mode\":\"external-exact-grant\",\"intentRef\":" intent-ref ",\"grantRef\":" grant-ref ",\"planHash\":" sha256 ",\"singleUse\":true}}"
operation ::= "\"inspect\"" | "\"plan\"" | "\"invoke\""
identifier ::= "\"" lower id-tail "\""
runtime-ref ::= "\"runtime://" authority "/" identifier-body "\""
identity-ref ::= "\"identity://" authority "/" identifier-body "\""
provider-ref ::= "\"provider://" authority "/" identifier-body "\""
tool-ref ::= "\"tool://" authority "/" identifier-body "\""
project-ref ::= "\"project://" authority "/" identifier-body "\""
mcp-ref ::= "\"mcp://" authority "/accounts/" identifier-body "/providers/" identifier-body "/tools/" identifier-body "\""
artifact-ref ::= "\"artifact://" authority "/" path "/r" positive-digits "\""
schema-ref ::= "\"schema://" authority "/" path "/v" positive-digits "\""
intent-ref ::= "\"intent://" authority "/" path "\""
grant-ref ::= "\"grant://" authority "/" path "\""
artifact-list ::= "[]" | "[" artifact-ref ("," artifact-ref)* "]"
sha256 ::= "\"" hex64 "\""
authority ::= lower authority-tail
authority-tail ::= ([a-z0-9.-])*
path ::= path-char (path-char)*
path-char ::= [A-Za-z0-9._:/-]
identifier-body ::= lower id-tail
id-tail ::= ([a-z0-9._:-])*
positive-int ::= [1-9] ([0-9])*
nonnegative-int ::= "0" | positive-int
positive-digits ::= [1-9] ([0-9])*
hex64 ::= hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex
hex ::= [a-f0-9]
lower ::= [a-z]
